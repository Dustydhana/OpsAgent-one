AWS_REGION=us-east-1
AWS_INVENTORY_REGIONS=us-east-1
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/OpsAgentConnectorRole
AWS_EXTERNAL_ID=replace-with-a-unique-random-value
AWS_ROLE_SESSION_NAME=opsagent-connector
AWS_INVENTORY_SYNC_ENABLED=true
AWS_INVENTORY_SYNC_INTERVAL_SECONDS=300
AWS_DRY_RUN=true
AWS_ALLOWED_ACTIONS=
