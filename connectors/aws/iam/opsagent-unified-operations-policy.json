{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEC2Inventory",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeImages",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInternetGateways",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeRegions",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSnapshots",
        "ec2:DescribeSubnets",
        "ec2:DescribeTags",
        "ec2:DescribeVolumes",
        "ec2:DescribeVolumesModifications",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageCurrentSelectedInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:TerminateInstances"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:701573843415:instance/i-0b803014af102ad61",
        "arn:aws:ec2:us-east-1:701573843415:instance/i-01f77f88a646a2dea",
        "arn:aws:ec2:us-east-1:701573843415:instance/i-08ec28b45e8467c0a",
        "arn:aws:ec2:us-east-1:701573843415:instance/i-0da0c6e4524cbd334"
      ]
    },
    {
      "Sid": "ManageFutureTaggedInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:701573843415:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/OpsAgentManaged": "true"
        }
      }
    },
    {
      "Sid": "ManageEBSVolumes",
      "Effect": "Allow",
      "Action": "ec2:ModifyVolume",
      "Resource": "arn:aws:ec2:us-east-1:701573843415:volume/*"
    },
    {
      "Sid": "DetachSecondaryNetworkInterfaces",
      "Effect": "Allow",
      "Action": "ec2:DetachNetworkInterface",
      "Resource": "arn:aws:ec2:us-east-1:701573843415:network-interface/*"
    },
    {
      "Sid": "CreateEBSSnapshots",
      "Effect": "Allow",
      "Action": "ec2:CreateSnapshot",
      "Resource": [
        "arn:aws:ec2:us-east-1:701573843415:volume/*",
        "arn:aws:ec2:us-east-1::snapshot/*"
      ]
    },
    {
      "Sid": "TagSnapshotsDuringCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-1::snapshot/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateSnapshot"
        }
      }
    },
    {
      "Sid": "DeleteEBSSnapshots",
      "Effect": "Allow",
      "Action": "ec2:DeleteSnapshot",
      "Resource": "arn:aws:ec2:us-east-1::snapshot/*"
    },
    {
      "Sid": "DeleteExplicitlyTaggedEBSVolumes",
      "Effect": "Allow",
      "Action": "ec2:DeleteVolume",
      "Resource": "arn:aws:ec2:us-east-1:701573843415:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/OpsAgentDeletable": "true"
        }
      }
    },
    {
      "Sid": "ReadSsmManagedNodesDocumentsAndResults",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeDocument",
        "ssm:DescribeInstanceInformation",
        "ssm:GetCommandInvocation",
        "ssm:GetDocument",
        "ssm:ListCommandInvocations",
        "ssm:ListCommands",
        "ssm:ListDocuments"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UseAnyOpsAgentRunbookWithoutPolicyChanges",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-east-1:701573843415:document/OpsAgent-*"
    },
    {
      "Sid": "RunOnlyOnOpsAgentManagedInstances",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-east-1:701573843415:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/OpsAgentManaged": "true"
        }
      }
    },
    {
      "Sid": "ManageOpsAgentDocuments",
      "Effect": "Allow",
      "Action": [
        "ssm:CreateDocument",
        "ssm:UpdateDocument",
        "ssm:UpdateDocumentDefaultVersion",
        "ssm:DescribeDocument"
      ],
      "Resource": "arn:aws:ssm:us-east-1:701573843415:document/OpsAgent-*"
    }
  ]
}
