# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Slack (Socket Mode) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
OPSAGENT_API_SECRET=replace-with-a-stable-random-secret-of-at-least-32-characters
SLACK_CHANNEL=#ops-alerts
GRAFANA_SLACK_BOT_NAME=Grafana Alerts
# Comma-separated Slack user IDs (recommended), usernames, display names, or emails.
SLACK_APPROVERS=U0123456789
SLACK_APPROVAL_EXPIRY_MINUTES=15
SLACK_AWS_VERIFY_SECONDS=120
# Keep false in production to require a second person to approve the request.
SLACK_ALLOW_SELF_APPROVAL=false
# Optional: defaults to WINDOWS_EC2_HOST, then DEFAULT_TARGET_HOST
SLACK_TARGET_HOST=windows.ec2.public.ip.or.dns

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_COST_PER_MILLION=0.15
OPENAI_OUTPUT_COST_PER_MILLION=0.60

# --- PostgreSQL server inventory ---
DATABASE_URL=postgresql://opsagent:password@localhost:5432/opsagent
SERVER_INVENTORY_CACHE_SECONDS=30
# Enables the guarded PostgreSQL inventory editor in Streamlit.
INVENTORY_EDIT_ENABLED=false
# Self-signup creates Viewer accounts only. Admins promote users separately.
APP_SIGNUP_ENABLED=false

# --- AWS EC2 target server ---
# Provider-neutral default used when an alert does not identify an inventory host.
DEFAULT_TARGET_HOST=your.server.ip.or.dns
# Legacy compatibility only; leave blank for new deployments.
EC2_HOST=
EC2_USERNAME=ubuntu
EC2_KEY_PATH=./opsagent-key.pem
EC2_SSH_PORT=22
AWS_REGION=ap-south-1
# Optional named local AWS CLI profile; leave blank for IAM role/default credentials.
AWS_PROFILE=
AWS_INVENTORY_SYNC_ENABLED=true
AWS_INVENTORY_SYNC_INTERVAL_SECONDS=60
# Comma-separated regions. Keep this narrow to control API usage.
AWS_INVENTORY_REGIONS=us-east-1
# Keep true for a safe management demo. AWS validates calls but does not change resources.
AWS_DRY_RUN=true
# Enterprise customer connector (recommended). The base credential chain must
# be allowed to call sts:AssumeRole on this role. Never place these values in React.
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=
AWS_ROLE_SESSION_NAME=opsagent-connector
# Explicit mutation allowlist: start_instance,stop_instance,reboot_instance,resize_instance,extend_volume,detach_secondary_nic,terminate_instance,create_snapshot,delete_snapshot,delete_volume,provision_instance
# delete_volume is intentionally omitted below. Enable it only after testing with a disposable,
# detached volume tagged OpsAgentDeletable=true.
AWS_ALLOWED_ACTIONS=start_instance,stop_instance,reboot_instance,resize_instance,extend_volume,create_snapshot,delete_snapshot
## Approved AWS Systems Manager host runbooks. Each action resolves only to
## SSM document OpsAgent-<action>; arbitrary commands/documents are rejected.
SSM_OPERATIONS_DRY_RUN=true
SSM_ALLOWED_ACTIONS=restart_service,install_windows_feature,remove_windows_feature,create_domain_user,join_computer_to_domain,create_a_record,create_dhcp_scope,install_certificate,install_security_updates
SCCM_MODE=ssm
SCCM_INSTANCE_ID=
SCCM_REGION=us-east-1
SCCM_INVENTORY_DOCUMENT=OpsAgent-sccm_inventory
SCCM_COMMAND_TIMEOUT_SECONDS=300
SCCM_CACHE_SECONDS=60
SSM_DOCUMENT_PREFIX=OpsAgent-
SSM_COMMAND_TIMEOUT_SECONDS=600
AWS_DELETE_VOLUME_REQUIRED_TAG_KEY=OpsAgentDeletable
AWS_DELETE_VOLUME_REQUIRED_TAG_VALUE=true

# --- VMware ESXi / vCenter ---
# Use a dedicated least-privilege vCenter service account in production.
VMWARE_ENDPOINT=192.168.51.130
VMWARE_PORT=443
VMWARE_USERNAME=root
VMWARE_PASSWORD=replace-with-secret
# Lab ESXi normally has a self-signed certificate. Keep true in production.
VMWARE_VERIFY_SSL=false
# Keep true for this free-ESXi demo and until every workflow is approved.
VMWARE_DRY_RUN=true
# Explicit mutation allowlist. patch_host/create_vm validate a plan in dry-run only.
VMWARE_ALLOWED_ACTIONS=power_on_vm,power_off_vm,reboot_guest,create_snapshot,remove_snapshot,resize_vm,extend_disk,enter_maintenance,exit_maintenance,reboot_host,shutdown_host,create_vm,patch_host

# --- Optional Windows EC2 target (requires OpenSSH on Windows) ---
WINDOWS_EC2_HOST=windows.ec2.public.ip.or.dns
WINDOWS_EC2_USERNAME=Administrator
WINDOWS_EC2_KEY_PATH=./opsagent-key.pem
WINDOWS_EC2_SSH_PORT=22
# Optional real subnet gateway used in network-failure reports.
TARGET_GATEWAY_IP=

# --- Incident response ---
MONITORING_SERVICE_NAME=Alloy
# Optional comma-separated services that must always be running.
CRITICAL_SERVICE_NAMES=
MONITORING_SERVICE_INSTALL_HINT=Install and enable the expected monitoring service on this host.
ONCALL_SLACK_USER=dhanashekar805
SERVER_OS=auto

# --- Optional tuning ---
ALERT_KEYWORDS=down,alert,server,issue,error,fail,outage,unreachable,crash,not responding
MAX_AGENT_ITERATIONS=6
SSH_TIMEOUT=10
SSH_COMMAND_TIMEOUT=30
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=1
STARTUP_ALERT_LOOKBACK_MINUTES=60
SLACK_ALERT_POLL_SECONDS=30
HUMAN_MENTION_LOOKBACK_MINUTES=10
ALERT_DEDUP_MINUTES=10
DISK_ALERT_MUTE_MINUTES=20
# Optional application-owner email escalation (enabled when recipient is set)
APPLICATION_OWNER_EMAIL=app-owner@example.com
SERVER_TEAM_EMAIL=server-team@example.com
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=ops-agent@example.com
SMTP_PASSWORD=replace-with-app-password-or-secret
SMTP_FROM_EMAIL=ops-agent@example.com
SMTP_USE_TLS=true
INBOUND_EMAIL_ENABLED=false
# Generic IMAP mailbox. Microsoft 365 commonly uses outlook.office365.com:993.
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USERNAME=ops-agent@example.com
IMAP_PASSWORD=replace-with-app-password-or-secret
IMAP_FOLDER=INBOX
INBOUND_EMAIL_POLL_SECONDS=30
INBOUND_EMAIL_LOOKBACK_MINUTES=60
# Exact comma-separated addresses; messages from all other senders are ignored.
EMAIL_REQUEST_SENDERS=requester@example.com
EMAIL_APPROVERS=manager@example.com
EMAIL_APPROVAL_EXPIRY_MINUTES=30
EMAIL_AWS_VERIFY_SECONDS=120
EMAIL_APPROVAL_STORAGE=postgresql
EMAIL_APPROVAL_RETENTION_RECORDS=1000
APPLICATION_OWNER_UTILIZATION_THRESHOLD=75
UTILIZATION_RECHECK_SECONDS=300
# Free SCCM workflow simulator. Reboots are denied unless explicitly enabled.
SCCM_MODE=simulation
SCCM_ALLOWED_ACTIONS=create_patch_deployment
SCCM_ALLOW_REBOOT=false
SCCM_SIMULATED_COLLECTIONS=OPSAGENT-TEST-D1,OPSAGENT-TEST-D2,OPSAGENT-INFRA-D1,OPSAGENT-INFRA-D2,OPSAGENT-PROD-D1,OPSAGENT-PROD-D2,OPSAGENT-PROD-D3,OPSAGENT-PROD-D4

# Enterprise web and OAuth login. Keep all secrets on the API server.
OPSAGENT_FRONTEND_URL=http://localhost:5173
OPSAGENT_OAUTH_CALLBACK_BASE=http://localhost:5173
OPSAGENT_DEFAULT_ORGANIZATION_ID=
OPSAGENT_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
