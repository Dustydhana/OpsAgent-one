# Persistent API deployment (never commit real values)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
OPSAGENT_API_SECRET=generate-a-random-secret-with-at-least-48-characters
OPSAGENT_FRONTEND_URL=https://your-app.vercel.app
OPSAGENT_OAUTH_CALLBACK_BASE=https://your-api.example.com
OPSAGENT_CORS_ORIGINS=https://your-app.vercel.app
OPSAGENT_DEFAULT_ORGANIZATION_ID=org-default
OPSAGENT_COOKIE_SECURE=true
OPSAGENT_CONNECTORS_IN_API=false
APP_SIGNUP_ENABLED=false

# Keep all infrastructure changes simulated for the first deployment.
AWS_DRY_RUN=true
VMWARE_DRY_RUN=true
SSM_OPERATIONS_DRY_RUN=true
SCCM_MODE=simulation

# Add only the OAuth provider credentials you use.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional AI integration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
